<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ScriptureFlow_Touch.ScriptureWindow"
		xmlns:local="clr-namespace:ScriptureFlow_Touch.Entities"
        Background="Black"
        CanResize="False"
        WindowState="Maximized"
        SystemDecorations="None"
        Topmost="True"
        PointerPressed="OnScreenTapped">

	<Window.Styles>
		<Style Selector="Panel#SettingsPanel.slideIn">
			<Style.Animations>
				<Animation Duration="0:0:0.3" Easing="CubicEaseOut" FillMode="Forward">
					<KeyFrame Cue="0%">
						<Setter Property="TranslateTransform.X" Value="300"/>
					</KeyFrame>
					<KeyFrame Cue="100%">
						<Setter Property="TranslateTransform.X" Value="0"/>
					</KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>

		<Style Selector="Panel#SettingsPanel.slideOut">
			<Style.Animations>
				<Animation Duration="0:0:0.3" Easing="CubicEaseIn" FillMode="Forward">
					<KeyFrame Cue="0%">
						<Setter Property="TranslateTransform.X" Value="0"/>
					</KeyFrame>
					<KeyFrame Cue="100%">
						<Setter Property="TranslateTransform.X" Value="300"/>
					</KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>

		<Style Selector="ToggleButton.SegmentButton">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="#B0FFFFFF"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalAlignment" Value="Stretch"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Padding" Value="0,8"/>
			<Setter Property="CornerRadius" Value="9"/>
			<Setter Property="BorderThickness" Value="0"/>
		</Style>

		<Style Selector="ToggleButton.SegmentButton:checked">
			<Setter Property="Background" Value="#35FFFFFF"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>
	</Window.Styles>

	<Grid>
		<Image x:Name="BgImage" Stretch="UniformToFill"/>

		<Border Background="#70000000"/>

		

		<Grid ColumnDefinitions="*, Auto">

			<Panel Grid.Column="0" Margin="94,94,40,94" ClipToBounds="True">

				<Grid RowDefinitions="*, Auto">

					<Panel Grid.Row="0" ClipToBounds="True" VerticalAlignment="Center">
						<TextBlock x:Name="VerseText"
								   TextAlignment="Center"
								   Margin="0,20,0,0"
								   Foreground="White"
								   FontWeight="SemiBold"
								   TextWrapping="Wrap"
								   TextTrimming="WordEllipsis">
							<TextBlock.RenderTransform>
								<TranslateTransform X="0" Y="0"/>
							</TextBlock.RenderTransform>
						</TextBlock>
					</Panel>

					<StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,24,0,0">
						<TextBlock x:Name="RefBlock"
								   Foreground="#E6E6E6"
								   FontSize="28"
								   TextAlignment="Right" />

						<TextBlock x:Name="InfoLeft"
								   Foreground="#C8C8C8"
								   FontSize="24"
								   HorizontalAlignment="Left"
								   IsVisible="True" />
					</StackPanel>
				</Grid>
			</Panel>
<!-- Settings Panel -->
			<Panel Grid.Column="1"
	   x:Name="SettingsPanel"
	   Width="350"
	   Focusable="False"
	   KeyboardNavigation.IsTabStop="False"
	   IsVisible="False">

				<Panel.RenderTransform>
					<TranslateTransform X="300"/>
				</Panel.RenderTransform>

				<!-- 1. Completely clear glass base matching your new preference -->
				<Border x:Name="SettingsGlassBase"
						CornerRadius="40 0 0 40"
						IsHitTestVisible="False"
						BorderBrush="#35FFFFFF"
					BorderThickness="1 1 0 1">
					<Border.Background>
						<!-- Smooth, clear white tint with no blur effect -->
						<SolidColorBrush Color="White" Opacity="0.15"/>
					</Border.Background>
				</Border>

				<!-- 2. Inner depth 'lip' border for crisp glass physics -->
				<Border CornerRadius="40 0 0 40"
						Padding="1"
						Margin="0"
						IsHitTestVisible="False">
					<Border CornerRadius="40 0 0 40"
							Background="#05FFFFFF"
							BorderBrush="#25FFFFFF"
							BorderThickness="1 1 0 1"/>
				</Border>

				<!-- 3. Your original settings content -->
				<StackPanel Margin="35" Spacing="20">
					<TextBlock Text="Settings" Foreground="White" FontWeight="SemiBold" FontSize="34"/>
					
					<!-- Rest of your settings elements go here -->

					<StackPanel Margin="20" Spacing="25">
						<TextBlock Text="Verse Categories"
								   Foreground="White"
								   FontWeight="SemiBold"
								   FontSize="24"
								   Margin="0,0,0,10"/>

						<StackPanel Spacing="18">

							<Grid ColumnDefinitions="*, Auto">
								<TextBlock Grid.Column="0" Text="Promises" Foreground="White" FontSize="20" FontWeight="Medium" 
										   VerticalAlignment="Center" />
								<ToggleSwitch Grid.Column="1"
											  x:Name="Promises"
											  IsChecked="False"
											  OnContent=""
											  OffContent=""
											  IsCheckedChanged="OnCategoryCheckedChanged"/>
							</Grid>

							<Grid ColumnDefinitions="*, Auto">
								<TextBlock Grid.Column="0" Text="Proverbs" Foreground="White" FontSize="20" FontWeight="Medium" 
										   VerticalAlignment="Center" />
								<ToggleSwitch Grid.Column="1"
											  x:Name="Proverbs"
											  IsChecked="False"
											  OnContent=""
											  OffContent=""
											  IsCheckedChanged="OnCategoryCheckedChanged"/>
							</Grid>

							<Grid ColumnDefinitions="*, Auto">
								<TextBlock Grid.Column="0" Text="Psalms" Foreground="White" FontSize="20" FontWeight="Medium" 
										   VerticalAlignment="Center" />
								<ToggleSwitch Grid.Column="1"
											  x:Name="Psalms"
											  IsChecked="False"
											  OnContent=""
											  OffContent=""
											  IsCheckedChanged="OnCategoryCheckedChanged"/>
							</Grid>

							<Grid ColumnDefinitions="*, Auto">
								<TextBlock Grid.Column="0" Text="Encouragement" Foreground="White" FontSize="20" FontWeight="Medium" 
										   VerticalAlignment="Center" />
								<ToggleSwitch Grid.Column="1"
											  x:Name="Encouragement"
											  IsChecked="True"
											  OnContent=""
											  OffContent=""
											  IsCheckedChanged="OnCategoryCheckedChanged"/>
							</Grid>

						</StackPanel>
					</StackPanel>

					<Separator Background="#15FFFFFF" Height="1"/>

					<StackPanel Margin="20" Spacing="25">
						<TextBlock Text="Verse Interval"  
								   Foreground="White"
								   FontWeight="SemiBold"
								   FontSize="24"
								   Margin="0,0,0,10"/>

						<Border Background="#10FFFFFF"
								BorderBrush="#15FFFFFF"
								BorderThickness="1"
								CornerRadius="12"
								Padding="3">

							<UniformGrid Rows="1" Columns="5">

								<ToggleButton x:Name="Btn5s"
											  Content="5s"
											  IsChecked="True"
											  Tag="0"
											  Classes="SegmentButton"											  
											  IsCheckedChanged="OnIntervalCheckedChanged"/>

								<ToggleButton x:Name="Btn10s"
											  Content="10s"
											  IsChecked="False" Tag="1"
											  Classes="SegmentButton"
											  IsCheckedChanged="OnIntervalCheckedChanged"/>

								<ToggleButton x:Name="Btn20s"
											  Content="20s"
											  IsChecked="False"
											  Tag="2"
											  Classes="SegmentButton"
											  IsCheckedChanged="OnIntervalCheckedChanged"/>

								<ToggleButton x:Name="Btn30s"
											  Content="30s"
											  IsChecked="False"
											  Tag="3"
											  Classes="SegmentButton"
											  IsCheckedChanged="OnIntervalCheckedChanged"/>

								<ToggleButton x:Name="Btn60s"
											  Content="60s"
											  IsChecked="False"
											  Tag="4"
											  Classes="SegmentButton"
											  IsCheckedChanged="OnIntervalCheckedChanged"/>

							</UniformGrid>
						</Border>
					</StackPanel>

					<Separator Background="#15FFFFFF" Height="1"/>

					<StackPanel Margin="20" Spacing="25">
						<TextBlock Text="Verse Background"
								   FontSize="24"
								   FontWeight="SemiBold"
								   Foreground="White"
								   Margin="0,0,0,10"/>

						<ListBox x:Name="BackgroundSelector"
							 Background="Transparent"
							 MaxHeight="220"
							 ScrollViewer.VerticalScrollBarVisibility="Auto"
							 SelectionChanged="BackgroundSelector_SelectionChanged">

							<ListBox.ItemsPanel>
								<ItemsPanelTemplate>
									<UniformGrid Columns="2" HorizontalAlignment="Stretch"/>
								</ItemsPanelTemplate>
							</ListBox.ItemsPanel>

							<ListBox.ItemTemplate>
								<DataTemplate>
									<Border BorderBrush="Gray"
											BorderThickness="1"
											CornerRadius="6"
											ClipToBounds="True"
											Height="100"
											Margin="5"
											Background="{Binding ThumbnailColor}">
										<Grid>
											<Image Source="{Binding ThumbnailImage, Mode=OneWay}" Stretch="UniformToFill"/>
											<Border Background="#A0000000" VerticalAlignment="Bottom" Height="28">
												<TextBlock Text="{Binding DisplayName}"
														   Foreground="White"
														   FontSize="12"
														   HorizontalAlignment="Center"
														   VerticalAlignment="Center"/>
											</Border>
										</Grid>
									</Border>
								</DataTemplate>
							</ListBox.ItemTemplate>

							<local:VerseBackground DisplayName="Encouragement" ThumbnailPath="avares://ScriptureFlow_Touch/Backgrounds/Encouragement/Encouragement.png"/>
							<local:VerseBackground DisplayName="Promises" ThumbnailPath="avares://ScriptureFlow_Touch/Backgrounds/Promises/Promises.jpg"/>
							<local:VerseBackground DisplayName="Proverbs" ThumbnailPath="avares://ScriptureFlow_Touch/Backgrounds/Proverbs/Proverbs.png"/>
							<local:VerseBackground DisplayName="Psalms" ThumbnailPath="avares://ScriptureFlow_Touch/Backgrounds/Psalms/Psalms.png"/>

							<local:VerseBackground DisplayName="Midnight Charcoal" SolidColor="#1E1E24"/>
							<local:VerseBackground DisplayName="Deep Burgundy" SolidColor="#3D0C11"/>
							<local:VerseBackground DisplayName="Sacred Navy" SolidColor="#111D33"/>
							<local:VerseBackground DisplayName="Forest Sanctuary" SolidColor="#1B2D2A"/>
						</ListBox>
					</StackPanel>
										
				</StackPanel>
			</Panel>
	<!-- End Settings Panel -->
</Grid>

		<Border x:Name="BottomPopup"
        CornerRadius="60"
        Padding="0"
        Width="600"
        Height="100"
        HorizontalAlignment="Center"
        VerticalAlignment="Bottom"
        Margin="0,0,0,40"
        Opacity="0"
        IsVisible="False">
			<Grid>
				<!-- 1. Match CornerRadius to parent to prevent corner bleeding -->
				<Border x:Name="GlassBase"
						CornerRadius="60"
						IsHitTestVisible="False"
						BorderBrush="#20FFFFFF"
						BorderThickness="1">					
					<Border.Background>
						<!-- 3. Pure white base with slight opacity for clean frosted glass -->
						<SolidColorBrush Color="White" Opacity="0.15"/>
					</Border.Background>
				</Border>

				<!-- This inner border adds a sophisticated, thin 'lip' to sell the depth -->
				<Border CornerRadius="60"
						Padding="1"
						Margin="0"
						IsHitTestVisible="False">
					<Border CornerRadius="60"
							Background="#05FFFFFF"
							BorderBrush="#25FFFFFF"
							BorderThickness="1"/>
				</Border>

				<StackPanel Orientation="Horizontal"
							Spacing="70"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							IsHitTestVisible="True">

					<Button Tapped="OnPrevTapped" Background="Transparent" BorderThickness="0" Focusable="False" 
							Padding="0" Width="64" Height="64" CornerRadius="32">
						<Grid Width="64" Height="64">
							<Path Data="M 4,0 L 10,0 L 10,48 L 4,48 Z M 10,24 L 30,0 L 30,48 Z M 30,24 L 50,0 L 50,48 Z"
								  Fill="White" Stretch="Uniform" Margin="16"
								  HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Grid>
					</Button>

					<Button Tapped="OnPlayPauseTapped" Background="Transparent" BorderThickness="0" Focusable="False" 
							Padding="0" Width="64" Height="64" CornerRadius="32">
						<ContentControl x:Name="PlayPauseIcon">
							<Grid Width="64" Height="64">
								<Path Data="M 16,12 L 26,12 L 26,52 L 16,52 Z M 38,12 L 48,12 L 48,52 L 38,52 Z"
									  Fill="White" Stretch="Uniform" Margin="16"
									  HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Grid>
						</ContentControl>
					</Button>

					<Button Tapped="OnNextTapped" Background="Transparent" BorderThickness="0" Focusable="False" 
							Padding="0" Width="64" Height="64" CornerRadius="32">
						<Grid Width="64" Height="64">
							<Path Data="M 4,0 L 24,24 L 4,48 Z M 24,0 L 44,24 L 24,48 Z M 44,0 L 50,0 L 50,48 L 44,48 Z"
								  Fill="White" Stretch="Uniform" Margin="16"
								  HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Grid>
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<Button x:Name="SettingsButton"
                ZIndex="999"
                Width="60"
                Height="60"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,20,20"
                Background="Transparent"
                BorderThickness="0"
                Click="OnSettingsTapped">
			<TextBlock Text="⚙" FontSize="36" Foreground="White"/>
		</Button>
	</Grid>
</Window>