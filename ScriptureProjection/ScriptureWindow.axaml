<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ScriptureProjection.ScriptureWindow"
        Background="Black"
        CanResize="False"
        WindowState="Maximized"
        SystemDecorations="None"
        Topmost="True"
        PointerPressed="OnScreenTapped">

	<Window.Styles>
		<Style Selector="Border#SettingsPanel.slideIn">
			<Style.Animations>
				<Animation Duration="0:0:0.3" Easing="CubicEaseOut" FillMode="Forward">
					<KeyFrame Cue="0%">
						<Setter Property="TranslateTransform.X" Value="300"/>
					</KeyFrame>
					<KeyFrame Cue="100%">
						<Setter Property="TranslateTransform.X" Value="0"/>
					</KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>

		<Style Selector="Border#SettingsPanel.slideOut">
			<Style.Animations>
				<Animation Duration="0:0:0.3" Easing="CubicEaseIn" FillMode="Forward">
					<KeyFrame Cue="0%">
						<Setter Property="TranslateTransform.X" Value="0"/>
					</KeyFrame>
					<KeyFrame Cue="100%">
						<Setter Property="TranslateTransform.X" Value="300"/>
					</KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>
		
	</Window.Styles>

	<Grid>
		<!-- Background image -->
		<Image x:Name="BgImage" Stretch="UniformToFill"/>

		<!-- Dim overlay -->
		<Border Background="#70000000"/>

		<!-- Verse content -->
		<Grid Margin="94">
			<Grid.RowDefinitions>
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<!-- Verse text -->
			<TextBlock Grid.Row="0"
                       x:Name="VerseText"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,20,0,0"
                       Foreground="White"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       TextTrimming="WordEllipsis"/>

			<!-- Reference and footer -->
			<StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,24,0,0">
				<TextBlock x:Name="RefBlock"
                           Foreground="#E6E6E6"
                           FontSize="28"
                           TextAlignment="Right" />

				<TextBlock x:Name="InfoLeft"
                           Foreground="#C8C8C8"
                           FontSize="24"
                           HorizontalAlignment="Left"
                           IsVisible="True" />
			</StackPanel>
		</Grid>

		<Border x:Name="BottomPopup"
        CornerRadius="50" Padding="0"
        Width="600"
        Height="100" HorizontalAlignment="Center"
        VerticalAlignment="Bottom"
        Margin="0,0,0,40"
        Opacity="0"
        IsVisible="False">
			<Grid>
				<Border CornerRadius="50"
						IsHitTestVisible="False"
						BorderBrush="#FFFFFFFF"
						BorderThickness="2">
					<Border.Effect>
						<BlurEffect Radius="20"/>
					</Border.Effect>
					<Border.Background>
						<SolidColorBrush Color="#1A1A1A" Opacity="0.50"/>
					</Border.Background>
				</Border>

				<StackPanel Orientation="Horizontal"
            Spacing="70"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsHitTestVisible="True">

					<Button Tapped="OnPrevTapped" Background="Transparent" BorderThickness="0" Focusable="False" Padding="0" Width="64" Height="64" CornerRadius="32">
						<Grid Width="64" Height="64">
							<Path Data="M 4,0 L 10,0 L 10,48 L 4,48 Z M 10,24 L 30,0 L 30,48 Z M 30,24 L 50,0 L 50,48 Z"
								  Fill="White" Stretch="Uniform" Margin="16"
								  HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Grid>
					</Button>

					<Button Tapped="OnPlayPauseTapped" Background="Transparent" BorderThickness="0" Focusable="False" Padding="0" Width="64" Height="64" CornerRadius="32">
						<ContentControl x:Name="PlayPauseIcon">
							<Grid Width="64" Height="64">
								<Path Data="M 16,12 L 26,12 L 26,52 L 16,52 Z M 38,12 L 48,12 L 48,52 L 38,52 Z"
									  Fill="White" Stretch="Uniform" Margin="16"
									  HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Grid>
						</ContentControl>
					</Button>

					<Button Tapped="OnNextTapped" Background="Transparent" BorderThickness="0" Focusable="False" Padding="0" Width="64" Height="64" CornerRadius="32">
						<Grid Width="64" Height="64">
							<Path Data="M 4,0 L 24,24 L 4,48 Z M 24,0 L 44,24 L 24,48 Z M 44,0 L 50,0 L 50,48 L 44,48 Z"
								  Fill="White" Stretch="Uniform" Margin="16"
								  HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Grid>
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<Border x:Name="SettingsPanel"
        Width="300"
        Background="#101010AA"
        BorderBrush="#FFFFFF22"
        BorderThickness="1"
        HorizontalAlignment="Right"
        IsVisible="False">
			<Border.RenderTransform>
				<TranslateTransform X="300"/>
			</Border.RenderTransform>

			<StackPanel Margin="20" Spacing="20">
				<TextBlock Text="Settings Panel" Foreground="White"/>
			</StackPanel>
		</Border>

		<Button x:Name="SettingsButton"
				ZIndex="999"
		        Width="60"
		        Height="60"
		        HorizontalAlignment="Right"
		        VerticalAlignment="Bottom"
		        Margin="0 0 20 20"
		        Background="Transparent"
		        BorderThickness="0"
		        Click="OnSettingsTapped">
			<TextBlock Text="⚙" FontSize="36" Foreground="White"/>
		</Button>
	</Grid>
</Window>