<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ScriptureProjection.ScriptureWindow"
        Background="Black"
        CanResize="False"
        WindowState="Maximized"
        SystemDecorations="None"
        Topmost="True"
		PointerPressed="OnScreenTapped">

	<Grid>		
		
        <!-- Background image -->
        <Image x:Name="BgImage" Stretch="UniformToFill"/>

        <!-- Dim overlay -->
        <Border Background="#70000000"/>

        <!-- Verse content -->
        <Grid Margin="94">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

			
				<!-- Verse text -->
			<TextBlock Grid.Row="0"
                       x:Name="VerseText"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,20,0,0"
                       Foreground="White"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       TextTrimming="WordEllipsis">

			</TextBlock>
			
            

            <!-- Reference and footer -->
            <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,24,0,0">
                <TextBlock x:Name="RefBlock"
                           Foreground="#E6E6E6"
                           FontSize="28"
                           TextAlignment="Right" />

                <TextBlock x:Name="InfoLeft"
                           Foreground="#C8C8C8"
                           FontSize="24"
                           HorizontalAlignment="Left"
                           IsVisible="True" />
            </StackPanel>

			<Border x:Name="BottomPopup"
        CornerRadius="40"
        Padding="0"
        HorizontalAlignment="Center"
        VerticalAlignment="Bottom"
        Margin="0,0,0,40"
        Opacity="0"
        IsVisible="False">

				<Grid>
					<!-- Blurred background layer -->
					<Border CornerRadius="40">
						<Border.Effect>
							<BlurEffect Radius="20"/>
						</Border.Effect>

						<Border.Background>
							<!-- Solid tint + transparency -->
							<SolidColorBrush Color="#101010" Opacity="0.4"/>
						</Border.Background>
					</Border>

					<!-- Clear content layer -->
					<StackPanel Orientation="Horizontal"
								Spacing="50"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Margin="25,20">

						<!-- Previous -->
						<Button PointerPressed="OnPrevClicked"
								Background="Transparent"
								BorderThickness="0"
								Focusable ="false">
							<TextBlock Text="⏮" FontSize="48" Foreground="White"/>
						</Button>

						<!-- Play / Pause -->
						<Button PointerPressed="OnPlayPauseClicked"
								Background="Transparent"
								BorderThickness="0">
							<TextBlock x:Name="PlayPauseIcon"
									   Text="⏯"
									   FontSize="48"
									   Foreground="White"/>
						</Button>

						<!-- Next -->
						<Button PointerPressed="OnNextClicked"
								Background="Transparent"
								BorderThickness="0">
							<TextBlock Text="⏭" FontSize="48" Foreground="White"/>
						</Button>

					</StackPanel>
				</Grid>
			</Border>



		</Grid>
    </Grid>
</Window>